# ROAM Athletics brand for the booking app (non-secret build settings).
# Source: DEX-CON-ONE/SOFAKING-RoamAthletics-site (site.config.ts, app/globals.css,
# public/images/roam-logo.png, app/favicon.ico). Keep the two in step.
#
# Use: load every line into the build environment before `npm run build`, e.g.
#   set -a; . brands/roam/brand.env; set +a; npm run build
VITE_BRAND_NAME="ROAM Athletics"
VITE_BRAND_SHORT_NAME="ROAM"
VITE_BRAND_TAGLINE="Your strength, refined."
VITE_BRAND_DESCRIPTION="Book classes and manage your membership at ROAM Athletics. Boutique strength and conditioning in a converted barn in Farnham."
VITE_BRAND_LOGO_URL="/logo.png"
VITE_BRAND_LOGO_BACKGROUND="#191a17"
VITE_BRAND_DOMAIN="roamathletics.com"
VITE_BRAND_SLUG="roam-athletics"
VITE_BRAND_FONT_DISPLAY="Josefin Sans"
VITE_BRAND_FONT_BODY="Arial, Helvetica"
VITE_BRAND_ASSETS_DIR="brands/roam"

# Palette (app/globals.css on the website)
VITE_BRAND_COLOR_BACKGROUND="#f3f0ea"
VITE_BRAND_COLOR_FOREGROUND="#191a17"
VITE_BRAND_COLOR_CARD="#fffdf8"
VITE_BRAND_COLOR_PRIMARY="#b66d3b"
VITE_BRAND_COLOR_PRIMARY_FOREGROUND="#ffffff"
VITE_BRAND_COLOR_SECONDARY="#313b32"
VITE_BRAND_COLOR_ACCENT="#d8a268"
VITE_BRAND_COLOR_MUTED="#e9e4d9"
VITE_BRAND_COLOR_MUTED_FOREGROUND="#5b5c55"
VITE_BRAND_COLOR_BORDER="#d8d3c8"
VITE_BRAND_COLOR_CHROME="#191a17"
VITE_BRAND_COLOR_CHROME_FOREGROUND="#f3f0ea"

# Where the website lives today, and where "/" sends anonymous visitors.
# Change both when the site moves to its own domain, or point the redirect at
# the studio storefront (/s/<slug>) once the studio exists.
VITE_BRAND_SITE_URL="https://witty-desert-085536903.3.azurestaticapps.net"
VITE_ROOT_REDIRECT_URL="https://witty-desert-085536903.3.azurestaticapps.net"

# Show only screens that use real data; the rest render an empty state
# (src/config/live-screens.ts). Remove once the screens are wired up.
VITE_LIVE_DATA_ONLY="true"

# Social sign-in buttons. Switch to "true" once the provider is enabled in
# Supabase Auth for this project, then rebuild.
VITE_AUTH_GOOGLE_ENABLED="true"
VITE_AUTH_APPLE_ENABLED="false"

# The studio members land on after signing in: its slug, as in /s/<slug>/schedule.
# Set this once the Roam studio has been created in the setup wizard, then rebuild.
# VITE_DEFAULT_STUDIO_SLUG=""
